# Copy to .env (git-ignored) and fill in. Never commit real values.
# Each line notes where the value comes from. BRIEF.md → "Step 1 findings" has the details.

# Airthings consumer API (polled source; Lambda). dashboard: consumer-api-doc.airthings.com/dashboard → My Applications.
# Client "Portfolio-2026-Dec-AWS-Lambda": scope read:device:current_values, confidential, client credentials.
AIRTHINGS_CLIENT_ID=
AIRTHINGS_CLIENT_SECRET=

# Emporia (history source; Prefect, via PyEmVue). The Emporia app login: email + password
# (password added to the Google/Apple-created account through Emporia's create-account flow).
EMPORIA_EMAIL=
EMPORIA_PASSWORD=

# Prefect Cloud (Hobby). Written by `uvx prefect-cloud login` into ~/.prefect/profiles.toml; copy both values.
PREFECT_API_URL=
PREFECT_API_KEY=

# dbt platform (Developer plan; no API). Not secret: from the dbt platform URL
# https://<host>/<account id>/projects/<project id>/...
DBT_ACCESS_URL=
DBT_ACCOUNT_ID=
DBT_PROJECT_ID=

# AWS: no keys here. Use the CLI profile `serpentair` (`aws login --profile serpentair`); see docs/agents/aws.md.
# Snowflake (Standard edition, AWS US East (Ohio)). Read by infra/tf.sh. Not secret themselves:
# the private keys they point at are, and those live outside the repo (~/.snowflake/keys/).
# Org and account names: Snowsight → your name (bottom left) → Account → View account details.
SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=
# Your own (human) user. Runs infra/bootstrap; key-pair set on your user by hand (infra/README.md).
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PRIVATE_KEY_PATH=~/.snowflake/keys/admin.p8
# Service user created by infra/bootstrap; runs infra/envs/* (here and, in #9, in CI).
SNOWFLAKE_CI_USER=SVC_TERRAFORM_CI
SNOWFLAKE_CI_PRIVATE_KEY_PATH=~/.snowflake/keys/svc_terraform_ci.p8

# Local-dev dbt: your personal schema in SERPENTAIR_DEV (written by scripts/setup-snowflake.sh).
DBT_DEV_SCHEMA=
